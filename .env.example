# Your Kryptex username (kryptex.com account). Mining stays off while this is empty.
KRYPTEX_USER=
WORKER=homeserver

# Kill switch: false = miner always stopped.
MINING_ENABLED=true

# Power limit while mining (W). The card's normal limit (370W) is restored whenever the miner stops.
MINING_POWER_LIMIT=250
# Clock locks while mining (MHz); empty = no lock. Reset to normal whenever the miner stops.
# Tuned 2026-10-29 for Pearl: 810 MHz memory + 1500 MHz core = ~122 TH/s at ~200 W.
MINING_MEM_CLOCK=810
MINING_CORE_CLOCK=1500
# Seconds the GPU must be quiet before mining resumes.
RESUME_AFTER_IDLE=120

# Defaults used only until the coin switcher has picked a coin (its choice in
# state/active.env overrides ALGORITHM, POOL, the power limit and the clocks).
ALGORITHM=pearlhash
POOL=prl-us.kryptex.network:7048
EXTRA_ARGS=
