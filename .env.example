# Your Kryptex username (kryptex.com account). Mining stays off while this is empty.
KRYPTEX_USER=
WORKER=homeserver

# Kill switch: false = miner always stopped.
MINING_ENABLED=true

# Seconds the GPU must be quiet before mining resumes.
RESUME_AFTER_IDLE=120

# Your GPU as named in hashrate.no URLs (https://www.hashrate.no/gpus/<model>), e.g.
# 3080ti, 4090, 7900xtx. Used for benchmark hashrates until the miner has measured its own.
GPU_MODEL=3080ti

# Docker network your Prometheus is on (the exporter and switcher join it).
METRICS_NETWORK=grafana_default

# Control panel: host port and login. Make the password hash with
#   docker compose run --rm -it control python -m formlogin hash
CONTROL_PORT=8095
CONTROL_USERNAME=
CONTROL_PASSWORD_HASH=

# Extra SRBMiner arguments, if any.
EXTRA_ARGS=

# Coins, pools, power limits and clock tuning are in switcher/coins.toml.
